{
  "name": "@warp-ecosystem/warp-compiler",
  "version": "0.1.1",
  "description": "Compile multiple JavaScript modules into a single TurboWarp extension.",
  "type": "module",
  "bin": {
    "warp-compiler": "bin/warp-compiler.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warp-ecosystem/warp-registry.git"
  },
  "main": "src/index.js",
  "files": [
    "bin",
    "src",
    ".product.json"
  ],
  "scripts": {
    "build": "node ./bin/warp-compiler.js build",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "compiler",
    "cli"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "acorn": "^8.18.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.5.0",
    "rollup": "^4.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0"
  }
}
